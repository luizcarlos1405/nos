#!/bin/sh
# After a commit of named files only ("git commit <file>"), git commits a temporary index: the files
# pre-commit added there (the folders' index.json and agenda.ics) are in the commit and in the working
# tree, but git's own index keeps the old ones, which a later commit would bring back. Put the
# committed ones there too.
root=$(git rev-parse --show-toplevel)
indexes=$(node "$root/tools/month-files.mjs" --list 2>/dev/null) || indexes="data/agenda/index.json data/noticias/index.json"
for file in $indexes agenda.ics; do
  if git diff --quiet HEAD -- "$root/$file" 2>/dev/null && ! git diff --cached --quiet HEAD -- "$root/$file" 2>/dev/null; then
    git add -- "$root/$file"
  fi
done
exit 0
