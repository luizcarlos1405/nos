#!/bin/sh
# Checks the site's month files (the agenda's and the news') and rebuilds the files made from them, from
# what is being committed (the staged files of data/, js/ and tools/, never unstaged edits), and adds them
# to the commit, so they can't fall behind:
#   - the index.json of each folder (data/agenda/ and data/noticias/, AGENDA_DIR and NEWS_DIR in
#     js/config.js), the months the pages read, by tools/month-files.mjs;
#   - agenda.ics, the calendar "Salvar tudo na agenda" subscribes people to, by tools/agenda-ics.mjs.
# A commit that doesn't change them leaves them as they are (the same data always gives the same files).
# A row in another file than its day's month, or one the site couldn't read, stops the commit with the
# reason; node tools/month-files.mjs --fix moves rows to the file they belong in.
#
# Git runs it once the clone points at this folder (worktrees share the setting):
#   git config core.hooksPath .githooks
set -e

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: Node 22 or newer is needed to check the month files and rebuild their index and agenda.ics (tools/); nothing was committed." >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# The staged files the generated ones are made from, as they will be committed.
git ls-files -z -- js tools data | git checkout-index -z --stdin --prefix="$tmp/"

if ! node "$tmp/tools/month-files.mjs" >"$tmp/log" 2>&1; then
  cat "$tmp/log" >&2
  echo "pre-commit: the month files need a fix (see above); nothing was committed." >&2
  exit 1
fi
if ! node "$tmp/tools/agenda-ics.mjs" "$tmp/agenda.ics" >"$tmp/log" 2>&1; then
  cat "$tmp/log" >&2
  echo "pre-commit: agenda.ics could not be rebuilt (see above); nothing was committed." >&2
  exit 1
fi

# Where the indexes are: one per folder of month files (tools/folders.mjs, as staged).
indexes=$(node "$tmp/tools/month-files.mjs" --list)

for file in $indexes agenda.ics; do
  if ! cmp -s "$tmp/$file" "$root/$file"; then
    mkdir -p "$(dirname "$root/$file")"
    cp "$tmp/$file" "$root/$file"
  fi
  if ! git diff --quiet -- "$root/$file" 2>/dev/null || ! git ls-files --error-unmatch -- "$root/$file" >/dev/null 2>&1; then
    git add -- "$root/$file"
    echo "pre-commit: $file rebuilt from the month files and added to this commit."
  fi
done
